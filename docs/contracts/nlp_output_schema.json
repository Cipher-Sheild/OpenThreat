{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://openthreat.local/contracts/nlp_output_schema.json",
  "title": "NLP Output Schema",
  "description": "Response of POST /analyze on Member 1's NLP service. v1.1 — see docs/contracts/CHANGELOG.md.",
  "type": "object",
  "definitions": {
    "evidence": {
      "type": "object",
      "description": "Where a fact came from. Offsets index into the analyzed text (for PDFs: the pages joined with '\\n\\n').",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 0
        },
        "page_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "text",
        "char_start",
        "char_end",
        "page_number"
      ]
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "THREAT_ACTOR",
        "MALWARE",
        "TOOL",
        "VULNERABILITY",
        "TECHNIQUE",
        "ORGANIZATION",
        "OBSERVABLE"
      ]
    },
    "relation_type": {
      "type": "string",
      "enum": [
        "USES",
        "DEPLOYS",
        "EXPLOITS",
        "TARGETS",
        "ATTRIBUTED_TO"
      ]
    }
  },
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Unique identifier for the document (echoed from the request)"
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "url"
      ]
    },
    "entities": {
      "type": "array",
      "description": "One item per mention. The same canonical_name can appear several times.",
      "items": {
        "type": "object",
        "properties": {
          "mention": {
            "type": "string"
          },
          "canonical_name": {
            "type": "string"
          },
          "type": {
            "$ref": "#/definitions/entity_type"
          },
          "subtype": {
            "type": [
              "string",
              "null"
            ],
            "description": "For OBSERVABLE: ipv4, ipv6, domain, url, email, md5, sha1, sha256. Otherwise null."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "char_start": {
            "type": "integer",
            "minimum": 0
          },
          "char_end": {
            "type": "integer",
            "minimum": 0
          },
          "page_number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "mention",
          "canonical_name",
          "type",
          "confidence",
          "char_start",
          "char_end",
          "page_number"
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "description": "canonical_name of the subject entity"
          },
          "subject_type": {
            "$ref": "#/definitions/entity_type"
          },
          "relation": {
            "$ref": "#/definitions/relation_type"
          },
          "object": {
            "type": "string",
            "description": "canonical_name of the object entity"
          },
          "object_type": {
            "$ref": "#/definitions/entity_type"
          },
          "negated": {
            "type": "boolean",
            "description": "True when the sentence denies the fact (e.g. 'no longer uses', 'is not attributed to')."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "$ref": "#/definitions/evidence"
          }
        },
        "required": [
          "subject",
          "subject_type",
          "relation",
          "object",
          "object_type",
          "negated",
          "confidence",
          "evidence"
        ]
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "mitre_attack_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "e.g. T1059.001; null if no confident mapping"
          },
          "mitre_attack_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "$ref": "#/definitions/evidence"
          }
        },
        "required": [
          "description",
          "mitre_attack_id",
          "confidence",
          "evidence"
        ]
      }
    },
    "temporal_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "description": "Short phrase that triggered the event"
          },
          "entity": {
            "type": "string",
            "description": "canonical_name of the entity the date belongs to"
          },
          "time": {
            "type": "string",
            "description": "ISO 8601 date, possibly partial: YYYY, YYYY-MM or YYYY-MM-DD"
          },
          "type": {
            "type": "string",
            "enum": [
              "FIRST_SEEN",
              "DISCLOSED",
              "PATCHED",
              "ACTIVE",
              "RETIRED",
              "OBSERVED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "$ref": "#/definitions/evidence"
          }
        },
        "required": [
          "event",
          "entity",
          "time",
          "type",
          "confidence"
        ]
      }
    },
    "document_embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 768,
      "maxItems": 768,
      "description": "L2-normalised dense vector (768 dims, cosine distance) of the whole document"
    },
    "novelty": {
      "type": "array",
      "description": "Always [] in /analyze. Novelty labels come from POST /classify_novelty, after Member 2 has fetched candidate facts.",
      "items": {
        "$ref": "nlp_service_api.json#/definitions/novelty_result"
      }
    },
    "processing": {
      "type": "object",
      "properties": {
        "model_version": {
          "type": "string"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "embedding_model": {
          "type": "string"
        },
        "embedding_dim": {
          "type": "integer"
        }
      },
      "required": [
        "model_version",
        "processed_at",
        "embedding_model",
        "embedding_dim"
      ]
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    }
  },
  "required": [
    "document_id",
    "source",
    "entities",
    "relations",
    "behaviors",
    "temporal_events",
    "document_embedding",
    "novelty",
    "processing",
    "schema_version"
  ]
}
