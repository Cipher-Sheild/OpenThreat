POSTGRES_USER=openthreat
POSTGRES_PASSWORD=
POSTGRES_DB=openthreat_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

QDRANT_HOST=qdrant
QDRANT_PORT=6333

NLP_SERVICE_PORT=8001
PLATFORM_SERVICE_PORT=8002
FRONTEND_PORT=4000

# NLP service embeddings (768-dim; Qdrant collections must use size 768, distance Cosine)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Set both to authorized Hugging Face checkpoint IDs or mounted model folders for hybrid extraction.
# Blank values use rule-only entity/relation extraction; embeddings still use a real model.
# Read docs/models-and-data.md before reproducing benchmark results.
NER_MODEL=alialtam/openthreat-ner
RE_MODEL=alialtam/openthreat-re

# Platform collectors
NVD_API_KEY=
INGEST_INTERVAL_SECONDS=300
NLP_TIMEOUT_SECONDS=180
AUTO_INGEST=false
